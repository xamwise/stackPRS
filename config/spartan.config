// Nextflow config for running pgsc_calc on a Slurm HPC (e.g. Spartan).
//
// Each Slurm array task (scripts/03_run_pgsc_calc.slurm) scores one chunk and
// runs pgsc_calc's processes *inside its own allocation* (local executor), so
// the scheduler sees one job per chunk instead of hundreds of tiny ones. The
// Slurm script passes --max_cpus/--max_memory from the allocation and sets the
// work directory per chunk on the command line.

process {
    executor = 'local'
}

singularity {
    enabled    = true
    autoMounts = true
    // Share one image cache across array tasks (exported by the Slurm script).
    cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR')
}
